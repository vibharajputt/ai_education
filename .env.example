# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# Base URL of the Express server. No trailing slash.
# In dev: http://localhost:3001
# In prod: https://your-api-domain.com
VITE_API_BASE_URL=http://localhost:3001

# ── Server (server/.env — copy this block there) ─────────────────────────────
# AI provider base URL (OpenAI-compatible)
# AI_API_BASE=https://api.openai.com/v1

# AI API key — NEVER put this in the frontend .env
# AI_API_KEY=sk-...

# Model name to use for all AI calls
# AI_MODEL=gpt-4o-mini

# Port the Express server listens on
# PORT=3001

# Max file size for resume uploads (bytes)
# UPLOAD_MAX_BYTES=5242880

# CORS origin — must match VITE_API_BASE_URL domain
# CORS_ORIGIN=http://localhost:5173

# ── Gemini API (server-side ONLY — never use VITE_ prefix) ───────────────────
# Used by /api/gemini-explain to call the Google Generative Language API.
# This key MUST NOT be set with the VITE_ prefix; it must never appear in the
# browser bundle. Set it in server/.env (or export it in your shell) only.
# GEMINI_API_KEY=your_gemini_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
